# -------------------------------------------------------------
# SuPrabhaat (सुप्रभात) - Environment Configuration
# Copy this file to .env and supply your credentials.
# -------------------------------------------------------------

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Google Gemini API Key (Required for AI blessing generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# WhatsApp Dispatch Configuration
# Comma-separated phone numbers with country code (e.g. 919876543210,919123456789)
RECIPIENT_NUMBERS=
WWEBJS_AUTH_PATH=./.wwebjs_auth

# Facebook Page Meta Graph API Configuration
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_API_VERSION=v20.0

# Cron Scheduling Configuration (Default: 07:00 AM IST daily)
CRON_SCHEDULE="0 7 * * *"
CRON_TIMEZONE="Asia/Kolkata"

# Dry Run Mode (true/false) - When true, tests generation without sending messages
DRY_RUN=false
